# nginx-local: the registry on the LAN (push and pull), and the token route it sends
# clients to. TLS with the certificate of the public name, so the name works on the LAN
# and on the host (the hosts file or DNS points it at the published address). Nothing else
# is served here: no page, no agent, nothing on the public network.
worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    error_log stderr warn;
    server_tokens off;
    sendfile on;

    # the containers' names are looked up per request, so a recreated container is found
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 443 ssl;
        server_name ${PUBLIC_DOMAIN};

        ssl_certificate /etc/nginx/certs/live/${PUBLIC_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/live/${PUBLIC_DOMAIN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        # image layers are large: no size limit, and no buffering of the upload
        client_max_body_size 0;
        proxy_request_buffering off;

        # the token protocol: the registry sends clients here, with their Basic credentials
        location = /auth/registry/token {
            set $auth_upstream http://auth:9000;
            proxy_pass $auth_upstream;
            proxy_set_header Host $host;
        }

        location /v2/ {
            set $registry_upstream http://registry:5000;
            proxy_pass $registry_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
        }

        location / {
            return 404;
        }
    }
}
