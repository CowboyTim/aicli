# nginx in front of the agent (the web interface): TLS with the certificates of certbot
# (the qr project's TLS and headers, adapted), and every request goes to the agent on
# the host's loopback. Stock nginx: no extra modules.
worker_processes 2;
error_log /var/log/nginx/error.log warn; # a tmpfs (docker-compose.yaml): small, not kept
pid /run/nginx.pid;

events {
    worker_connections 512;
}

http {
    server_tokens off;
    include /etc/nginx/mime.types;
    log_format main '$remote_addr - [$time_local] "$request" $status $body_bytes_sent "$http_user_agent"';
    access_log /var/log/nginx/access.log main; # the same tmpfs

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 4096;

    # searxng for other tools: a bearer token, and a rate limit per address
    # (the key of the map is the whole header: a 64 character token needs the bigger buckets)
    map_hash_bucket_size 128;
    map $http_authorization $searxng_ok {
        default 0;
        "Bearer ${SEARXNG_API_TOKEN}" 1;
    }
    limit_req_zone $binary_remote_addr zone=searxng:10m rate=2r/s;
    # the API of flm (/api/flm/): queued, not refused, at a rate per client
    limit_req_zone $binary_remote_addr zone=flm_api:10m rate=5r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;


    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name _;

        # the certificates of certbot (live/<name>/), by the name the client asks for
        ssl_certificate         /etc/nginx/certs/live/${PUBLIC_DOMAIN}/fullchain.pem;
        ssl_certificate_key     /etc/nginx/certs/live/${PUBLIC_DOMAIN}/privkey.pem;
        ssl_session_cache       shared:SSL:1m;
        ssl_session_timeout     10m;
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_ciphers             ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
        ssl_prefer_server_ciphers on;

        client_max_body_size    25m;  # /voice: a recording of about two minutes (the page limit is 20 MB)
        resolver                127.0.0.11 ipv6=off valid=3s;  # the docker DNS, for the name of the agent

        # the methods the page uses
        if ($request_method !~ ^(GET|POST)$) {
            return 444;
        }

        include /etc/nginx/security-headers.conf;

        # public: the login page and the stylesheet it uses (ai/ui, mounted here), and the
        # login itself (the auth service). Everything else needs the login (auth_request).
        location = /login.html {
            alias /etc/nginx/ui/login.html;
        }
        location = /theme.css {
            alias /etc/nginx/ui/theme.css;
        }
        # the icon of the pages (a strawberry, drawn for aicli): public, the login page shows it too
        location = /favicon.ico {
            alias /etc/nginx/ui/favicon.ico;
            add_header Cache-Control "public, max-age=86400";
        }
        location = /favicon.svg {
            alias /etc/nginx/ui/favicon.svg;
            add_header Cache-Control "public, max-age=86400";
        }
        location = /auth/login {
            limit_req zone=login burst=5 nodelay;
            set $auth http://auth:9000;
            proxy_pass $auth;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        # the login from another device: the phone asks about a ticket and redeems it (see auth.pl)
        location ~ ^/auth/qr/(peek|redeem)$ {
            limit_req zone=login burst=5 nodelay;
            set $auth http://auth:9000;
            proxy_pass $auth;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        location /auth/ {
            set $auth http://auth:9000;
            proxy_pass $auth;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        # the check of a request (auth_request): the auth service's JWT check, internal only
        location = /_gate {
            internal;
            set $auth_verify http://auth:9000/auth/verify;
            proxy_pass $auth_verify;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
        }
        location @login {
            return 302 /login.html;
        }

        # the agents (remote_agent.pm, the broker's listener): no login here, the agent's token is
        # its login. This is the broker's listener only; the web interface's routes are /agent/...
        location /agents/ {
            limit_req zone=login burst=10 nodelay;
            set $broker http://broker:9100;
            proxy_pass $broker;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_buffering off;
            proxy_read_timeout 120s;
        }
        location /searxng/ {
            if ($searxng_ok = 0) {
                return 401;
            }
            limit_req zone=searxng burst=20 nodelay;
            set $searxng http://searxng:8080;
            rewrite ^/searxng/(.*)$ /$1 break;
            proxy_pass $searxng;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }

        # the check of an API request: a token made for flm (aud=flm), internal only. Its user
        # and account go to flm; the token itself does not
        location = /_gate_flm {
            internal;
            set $auth_flm http://auth:9000/auth/verify?aud=flm;
            proxy_pass $auth_flm;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
        }
        # the API of flm (FastFlowLM on the NPU): the model list and inference, /api/flm/<path> is
        # flm's /<path> (/v1/models, /v1/chat/completions, /v1/audio/transcriptions). Each request
        # needs a token of the user's, from POST /auth/api/token, as Bearer
        location /api/flm/ {
            auth_request /_gate_flm;
            auth_request_set $api_user $upstream_http_x_user;
            auth_request_set $api_account $upstream_http_x_account;
            limit_req zone=flm_api burst=20;
            client_max_body_size 25m;
            set $flm http://flm:52625;
            rewrite ^/api/flm/(.*)$ /$1 break;
            proxy_pass $flm;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            proxy_set_header X-Aicli-User $api_user;
            proxy_set_header X-Aicli-Account $api_account;
            proxy_buffering off;
            proxy_read_timeout 600s;
        }

        location / {
            # the login first: no valid JWT goes to the login page
            auth_request /_gate;
            auth_request_set $aicli_user $upstream_http_x_user;
            # the login's account ID (a UUID kept in the passwd comment, see auth.pl): the agent's directory
            auth_request_set $aicli_account $upstream_http_x_account;
            # a renewed login (the auth service renews it in its second half): its cookie goes on
            auth_request_set $aicli_cookie $upstream_http_set_cookie;
            add_header Set-Cookie $aicli_cookie always;
            include /etc/nginx/security-headers.conf;
            error_page 401 = @login;
            # the agent by its name on the network aicli (resolved when a request comes, so nginx
            # starts whether or not the agent is up)
            set $agent http://agent:${AGENT_PORT};
            proxy_pass $agent;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            # the agent trusts this secret (it is not published): nginx has checked the login
            proxy_set_header X-Aicli-Gate ${AICLI_GATE_SECRET};
            proxy_set_header X-Aicli-User $aicli_user;
            proxy_set_header X-Aicli-Account $aicli_account;
            proxy_buffering off;   # server-sent events: each event goes out at once
            proxy_cache off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
        }
    }
}
