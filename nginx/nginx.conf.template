# nginx in front of the agent (the web interface): TLS with the certificates of certbot
# (the qr project's TLS and headers, adapted), and every request goes to the agent on
# the host's loopback. Stock nginx: no extra modules.
worker_processes 2;
error_log /dev/stdout warn;
pid /run/nginx.pid;

events {
    worker_connections 512;
}

http {
    server_tokens off;
    include /etc/nginx/mime.types;
    log_format main '$remote_addr - [$time_local] "$request" $status $body_bytes_sent "$http_user_agent"';
    access_log /dev/stdout main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 4096;

    # searxng for other tools: a bearer token, and a rate limit per address
    # (the key of the map is the whole header: a 64 character token needs the bigger buckets)
    map_hash_bucket_size 128;
    map $http_authorization $searxng_ok {
        default 0;
        "Bearer ${SEARXNG_API_TOKEN}" 1;
    }
    limit_req_zone $binary_remote_addr zone=searxng:10m rate=2r/s;
    limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;


    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name _;

        # the certificates of certbot (live/<name>/), by the name the client asks for
        ssl_certificate         /etc/nginx/certs/live/${PUBLIC_DOMAIN}/fullchain.pem;
        ssl_certificate_key     /etc/nginx/certs/live/${PUBLIC_DOMAIN}/privkey.pem;
        ssl_session_cache       shared:SSL:1m;
        ssl_session_timeout     10m;
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_ciphers             ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
        ssl_prefer_server_ciphers on;

        client_max_body_size    25m;  # /voice: a recording of about two minutes (the page limit is 20 MB)
        resolver                127.0.0.11 ipv6=off valid=3s;  # the docker DNS, for the name of the agent

        # the methods the page uses
        if ($request_method !~ ^(GET|POST)$) {
            return 444;
        }

        include /etc/nginx/security-headers.conf;

        # public: the login page and the stylesheet it uses (ai/ui, mounted here), and the
        # login itself (the auth service). Everything else needs the login (auth_request).
        location = /login.html {
            alias /etc/nginx/ui/login.html;
        }
        location = /theme.css {
            alias /etc/nginx/ui/theme.css;
        }
        location = /auth/login {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://auth:9000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        location /auth/ {
            proxy_pass http://auth:9000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        # the check of a request (auth_request): the auth service's JWT check, internal only
        location = /_gate {
            internal;
            proxy_pass http://auth:9000/auth/verify;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
        }
        location @login {
            return 302 /login.html;
        }

        location /searxng/ {
            if ($searxng_ok = 0) {
                return 401;
            }
            limit_req zone=searxng burst=20 nodelay;
            set $searxng http://searxng:8080;
            rewrite ^/searxng/(.*)$ /$1 break;
            proxy_pass $searxng;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
        }

        location / {
            # the login first: no valid JWT goes to the login page
            auth_request /_gate;
            auth_request_set $aicli_user $upstream_http_x_user;
            # a renewed login (the auth service renews it in its second half): its cookie goes on
            auth_request_set $aicli_cookie $upstream_http_set_cookie;
            add_header Set-Cookie $aicli_cookie always;
            include /etc/nginx/security-headers.conf;
            error_page 401 = @login;
            # the agent by its name on the network aicli (resolved when a request comes, so nginx
            # starts whether or not the agent is up)
            set $agent http://agent:${AGENT_PORT};
            proxy_pass $agent;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $remote_addr;
            # the agent trusts this secret (it is not published): nginx has checked the login
            proxy_set_header X-Aicli-Gate ${AICLI_GATE_SECRET};
            proxy_set_header X-Aicli-User $aicli_user;
            proxy_buffering off;   # server-sent events: each event goes out at once
            proxy_cache off;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
        }
    }
}
