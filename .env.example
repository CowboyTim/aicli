# Copy this to .env (next to docker-compose.yaml) and fill it in. Compose reads .env.
# AI_PROJECTS: the host directory whose subdirectories are the projects (the root).
AI_PROJECTS=/home/you/master
# PODMAN_SOCKET: the rootless Podman socket of the user that runs the broker.
# Enable it with: systemctl --user enable --now podman.socket
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# BROKER_UID / BROKER_GID: that user's ids (id -u, id -g). The socket is owned by them.
BROKER_UID=1000
BROKER_GID=1000

# The public address (nginx, TLS). The name must point at this host in DNS.
PUBLIC_DOMAIN=ai.example.org
# The e-mail for the certificate's notices, and the DNS provider of certbot (its plugin).
CERTBOT_EMAIL=you@example.org
DNS_PLUGIN=cloudflare
# The page of the agent, on this host's loopback (nginx proxies to it).
AGENT_PORT=8080
