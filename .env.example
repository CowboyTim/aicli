# Copy this to .env (next to docker-compose.yaml) and fill it in. Compose reads .env.
# AI_PROJECTS: the host directory whose subdirectories are the projects (the root).
AI_PROJECTS=/home/you/master
# BROKER_UID / BROKER_GID: the ids of the broker's socket owner (id -u, id -g).
BROKER_UID=1000
BROKER_GID=1000

PUBLIC_DOMAIN=ai.example.org
CERTBOT_EMAIL=you@example.org
# The page of the agent, on this host's loopback (nginx proxies to it).
AGENT_PORT=8080
# The secret of searxng (a random string: openssl rand -hex 32).
SEARXNG_SECRET=
# The token other tools send to searxng (Authorization: Bearer ...), at https://PUBLIC_DOMAIN/searxng/
SEARXNG_API_TOKEN=
# AI_ASR_URL: the speech recognizer of the agent (/voice). Optional: unset, it is the flm service
# of docker-compose.yaml (FastFlowLM on the NPU, http://flm:52625/v1/audio/transcriptions).
# AI_ASR_MODEL: its model (whisper-v3:turbo, as flm serves it).
