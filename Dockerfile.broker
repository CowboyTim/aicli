# The broker (broker.pl): a Perl program with JSON::XS, and podman-remote (the engine's
# client, for exec), in a container of its own. See docker-compose.yaml; it is the only container with the
# engine socket.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends perl libjson-xs-perl podman-remote \
 && rm -rf /var/lib/apt/lists/*
COPY broker.pl /usr/local/lib/aicli/broker.pl
COPY remote_hub.pm /usr/local/lib/aicli/remote_hub.pm
# the state of the agents (enrolled agents, the hashes of their tokens): a volume, writable by the
# broker's user (the file itself is 0600)
RUN mkdir -p /var/lib/aicli-broker && chmod 0777 /var/lib/aicli-broker
ENTRYPOINT ["perl", "/usr/local/lib/aicli/broker.pl"]
CMD ["serve"]
