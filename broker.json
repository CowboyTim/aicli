{
  "root": "/projects",
  "engine": "/run/engine/podman.sock",
  "socket": "/run/aicli-broker/broker.sock",
  "registries": {
    "${AICLI_REGISTRY_HOST}": {"username_env": "AICLI_REGISTRY_USER", "password_env": "AICLI_REGISTRY_PASSWORD"}
  },
  "pods": {
    "base": {
      "image": "${AICLI_POD_REGISTRY}/pod-bash:latest",
      "programs": ["bash", "perl", "grep"],
      "note": "the basic tools of every session: bash, perl and grep (general dev image)"
    },
    "node": {
      "image": "${AICLI_POD_REGISTRY}/pod-node:latest",
      "programs": ["node", "npm", "npx"],
      "note": "nodejs and npm, for nodejs projects only"
    },
    "arduino": {
      "image": "${AICLI_POD_REGISTRY}/pod-arduino:latest",
      "programs": ["arduino-cli", "python3"],
      "devices": ["/dev/ttyACM*", "/dev/ttyUSB*"],
      "usb_ids": ["0483:003a", "0483:003b", "2e3c:0049", "2e3c:5558"],
      "note": "arduino-cli and ESP32 boards, and the USB power meters (usb_logger); boards plugged in when the pod opens"
    },
    "rocm": {
      "image": "${AICLI_POD_REGISTRY}/pod-rocm:latest",
      "programs": ["python3", "hipcc", "rocminfo", "rocm-smi", "cargo"],
      "devices": ["/dev/kfd", "/dev/dri/card*", "/dev/dri/renderD*"],
      "seccomp": "unconfined",
      "ipc": "host",
      "note": "ROCm and the AMD GPU: python with torch, hipcc, rocminfo, rust"
    },
    "android": {
      "image": "${AICLI_POD_REGISTRY}/pod-android:latest",
      "programs": ["java", "javac", "gradle", "sdkmanager"],
      "note": "Android SDK and Gradle, for Android projects"
    }
  },
  "max_pods": 4,
  "idle_minutes": 30,
  "memory": "2g",
  "pids": 512,
  "userns": "keep-id"
}
