# The auth service (auth.pl): the logins of the web interface, PAM against the local accounts
# of this container, and the JWT that nginx checks (auth_request). See docker-compose.yaml.
# It runs as root: pam_unix reads /etc/shadow. Its key and its state are in the volume aicli-auth.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends perl libjson-xs-perl libcrypt-openssl-rsa-perl \
        libauthen-pam-perl libpam-modules qrencode \
 && rm -rf /var/lib/apt/lists/*
COPY auth/aicli-auth.pam /etc/pam.d/aicli-auth
COPY auth.pl /usr/local/lib/aicli/auth.pl
ENTRYPOINT ["perl", "/usr/local/lib/aicli/auth.pl"]
